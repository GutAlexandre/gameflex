{
  "window_name": "Zelda 64: Recompiled",
  "games": {
    "dir": "/opt/game",
    "rules": [
      { "extension": ".z64" }
    ]
  },
  "launch": {
    "bin": "/opt/run-zelda64.sh",
    "cwd": "/opt/zelda64",
    "process_group": true
  },
  "stop": { "mode": "pgroup" },
  "gamepad": { "enabled": true, "swap_xy_from_slot": -1 },
  "tools": [
    { "name": "route_audio" }
  ]
}
