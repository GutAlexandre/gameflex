# Configuration PulseAudio minimale pour le conteneur des ports PC (mode --system).
#
# - auth-anonymous=1 : pas de cookie d'authentification.
# - sink null ports_sink : le port y envoie son audio (par SDL), streamex
#   capture son monitor.

load-module module-null-sink sink_name=ports_sink sink_properties=device.description=Ports
load-module module-native-protocol-unix auth-anonymous=1
set-default-sink ports_sink
set-default-source ports_sink.monitor
