diff --git a/src/generate_version.cmake b/src/generate_version.cmake
index 558cd1b8..6edcb15a 100644
--- a/src/generate_version.cmake
+++ b/src/generate_version.cmake
@@ -38,4 +38,22 @@ if(GIT_EXECUTABLE)
 		endif()
 	endif()
 endif()
+# GameFlex: what the shader store's records depend on - the recompiler, and the renderer that
+# describes and creates pipelines (not its memory caches). A build that leaves these sources alone
+# keeps the store, whatever else it changes.
+set(KYTY_SHADER_STORE_STAMP "unknown")
+if(GRAPHICS_SOURCE_DIR)
+	file(GLOB_RECURSE store_sources LIST_DIRECTORIES false RELATIVE "${GRAPHICS_SOURCE_DIR}"
+		"${GRAPHICS_SOURCE_DIR}/shader/*" "${GRAPHICS_SOURCE_DIR}/host_gpu/renderer/*")
+	list(FILTER store_sources EXCLUDE REGEX "^host_gpu/renderer/cache/")
+	list(SORT store_sources)
+	set(store_digests "")
+	foreach(source IN LISTS store_sources)
+		file(SHA256 "${GRAPHICS_SOURCE_DIR}/${source}" digest)
+		string(APPEND store_digests "${source} ${digest}\n")
+	endforeach()
+	if(store_sources)
+		string(SHA256 KYTY_SHADER_STORE_STAMP "${store_digests}")
+	endif()
+endif()
 configure_file("${INPUT_FILE}" "${OUTPUT_FILE}")
diff --git a/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp b/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
index d9f9957a..f0e5cecd 100644
--- a/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
@@ -13,6 +13,7 @@
 #include <cstring>
 #include <fmt/format.h>
 #include <ranges>
+#include <string_view>
 #include <xxhash.h>
 #include <zstd.h>
 
@@ -62,9 +63,19 @@ uint64_t BuildStamp() {
 	return error ? 0 : static_cast<uint64_t>(time);
 }
 
+// GameFlex: the sources the records depend on (generate_version.cmake), so a build that changes
+// neither the recompiler nor the pipelines keeps the store. Without them, the executable's date.
+uint64_t StoreStamp() {
+	constexpr std::string_view sources = KYTY_SHADER_STORE_STAMP;
+	if (sources != "unknown") {
+		return XXH3_64bits(sources.data(), sources.size());
+	}
+	return BuildStamp();
+}
+
 // What every record depends on besides its own fields; empty when the build is unknown.
 std::vector<uint8_t> StoreHeader(const GraphicContext& graphics) {
-	const auto stamp = BuildStamp();
+	const auto stamp = StoreStamp();
 	if (stamp == 0) {
 		return {};
 	}
