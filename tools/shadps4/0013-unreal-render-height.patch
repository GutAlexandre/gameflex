+// GAMEFLEX_UE_RENDER_HEIGHT (720, 540, 360): the height an Unreal game computes its scene at. PS4
+// games output 1080p and the engine takes a percentage of it from its saved configuration,
+// <project>/saved/config/ps4/engine.ini, which it looks for in its own folder (the command line
+// has no effect on them). That folder is read-only, so <project>/saved is mounted elsewhere.
+static void MountUnrealRenderHeight(const std::filesystem::path& game_folder,
+                                    Core::FileSys::MntPoints* mnt) {
+    const char* height = std::getenv("GAMEFLEX_UE_RENDER_HEIGHT");
+    if (height == nullptr) {
+        return;
+    }
+    const auto value = std::strtoul(height, nullptr, 10);
+    if (value < 144 || value >= 1080) {
+        return;
+    }
+    // "../../../End/End.uproject -Messaging": the project, as the game names it in lower case.
+    std::string target;
+    std::ifstream(game_folder / "ue4commandline.txt") >> target;
+    auto project = std::filesystem::path(target).stem().string();
+    std::ranges::transform(project, project.begin(),
+                           [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    if (project.empty()) {
+        return;
+    }
+    const auto saved =
+        Common::FS::GetUserPath(Common::FS::PathType::UserDir) / "gameflex-unreal" / project;
+    std::filesystem::create_directories(saved / "config" / "ps4");
+    std::ofstream(saved / "config" / "ps4" / "engine.ini", std::ios::trunc)
+        << "[SystemSettings]\nr.ScreenPercentage=" << (value * 100 + 540) / 1080
+        << "\nr.DynamicRes.OperationMode=0\n";
+    mnt->Mount(saved, "/app0/" + project + "/saved", false);
+    LOG_INFO(Loader, "Unreal render height {}: project {}", value, project);
+}
